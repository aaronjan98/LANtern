FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api/ /app/api/
# The activity endpoints import the oracle (lantern.activity); it depends only
# on the stdlib, so the package comes along without extra requirements.
COPY lantern/ /app/lantern/

ENV LANTERN_DB=/var/lib/lantern/lantern.db

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
